#include<stdio.h>
#include<sys/ipc.h>
#include<sys/msg.h>

struct msgbuf
{
    long mtype;
    char mtext[100];
}msg;

int main()
{
    int msgid;

    msgid=msgget(1234,0666|IPC_CREAT);

    msg.mtype=1;

    printf("Enter Message: ");
    scanf("%s",msg.mtext);

    msgsnd(msgid,&msg,sizeof(msg),0);

    printf("Message Sent\n");

    return 0;
}
