#include <stdio.h>
#include <unistd.h>
#include <string.h>

int main() {
    int fd[2];
    char msg[] = "Hello from Parent";
    char buffer[100];

    pipe(fd);

    if (fork() > 0) {
        close(fd[0]);

        write(fd[1], msg, strlen(msg) + 1);
        close(fd[1]);

        printf("Parent: Message Sent\n");
    }
    else {
        close(fd[1]);

        read(fd[0], buffer, sizeof(buffer));
        close(fd[0]);

        printf("Child: Message Received = %s\n", buffer);
    }

    return 0;
}
