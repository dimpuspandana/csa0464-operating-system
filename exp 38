#include <stdio.h>
#include <stdlib.h>

int main()
{
    int req[20], n, head, diskSize;
    int i, seek = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter requests:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    seek += abs(diskSize - 1 - head);

    printf("Total Seek Time = %d\n", seek);

    return 0;
}
