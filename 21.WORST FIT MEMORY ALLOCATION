#include<stdio.h>

int main()
{
    int b[20],p[20],allocation[20];
    int nb,np,i,j,worst;

    printf("Enter number of blocks: ");
    scanf("%d",&nb);

    printf("Enter number of processes: ");
    scanf("%d",&np);

    printf("Enter block sizes:\n");
    for(i=0;i<nb;i++)
        scanf("%d",&b[i]);

    printf("Enter process sizes:\n");
    for(i=0;i<np;i++)
        scanf("%d",&p[i]);

    for(i=0;i<np;i++)
    {
        worst=-1;

        for(j=0;j<nb;j++)
        {
            if(b[j]>=p[i])
            {
                if(worst==-1 || b[j]>b[worst])
                    worst=j;
            }
        }

        allocation[i]=worst;

        if(worst!=-1)
            b[worst]-=p[i];
    }

    printf("\nProcess\tBlock\n");
    for(i=0;i<np;i++)
        printf("%d\t%d\n",i+1,allocation[i]+1);

    return 0;
}
