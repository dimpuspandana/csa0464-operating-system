#include <stdio.h>

int main() {
    FILE *fp;
    char str[100];

    fp = fopen("file.txt", "w");
    fprintf(fp, "Operating System Lab");
    fclose(fp);

    fp = fopen("file.txt", "r");
    fgets(str, 100, fp);
    printf("Content: %s\n", str);
    fclose(fp);

    remove("file.txt");
    printf("File Deleted Successfully\n");

    return 0;
}
