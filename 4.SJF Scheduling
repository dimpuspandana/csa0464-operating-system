#include <stdio.h>

void sjf(int p[], int at[], int bt[], int n) {
    int wt[n], tat[n], done[n];
    int time = 0, completed = 0;
    float total_wt = 0, total_tat = 0;

    for (int i = 0; i < n; i++)
        done[i] = 0;

    printf("\nExecution Order: ");

    while (completed < n) {
        int min = -1;

        for (int i = 0; i < n; i++) {
            if (done[i] == 0 && at[i] <= time) {
                if (min == -1 || bt[i] < bt[min])
                    min = i;
            }
        }

        if (min == -1) {
            time++;
            continue;
        }

        printf("P%d ", p[min]);

        time += bt[min];
        tat[min] = time - at[min];
        wt[min] = tat[min] - bt[min];

        total_wt += wt[min];
        total_tat += tat[min];

        done[min] = 1;
        completed++;
    }

    printf("\n\nP\tAT\tBT\tWT\tTAT\n");

    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\n",
               p[i], at[i], bt[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time = %.2f", total_wt / n);
    printf("\nAverage Turnaround Time = %.2f\n", total_tat / n);
}

int main() {
    int n;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    int p[n], at[n], bt[n];

    for (int i = 0; i < n; i++) {
        p[i] = i + 1;
        printf("Enter AT and BT for P%d: ", p[i]);
        scanf("%d%d", &at[i], &bt[i]);
    }

    sjf(p, at, bt, n);

    return 0;
}
