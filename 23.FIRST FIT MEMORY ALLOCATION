#include<stdio.h>

int main()
{
    int b[20],p[20],allocation[20];
    int nb,np,i,j;

    printf("Enter number of blocks: ");
    scanf("%d",&nb);

    printf("Enter number of processes: ");
    scanf("%d",&np);

    printf("Enter block sizes:\n");
    for(i=0;i<nb;i++)
        scanf("%d",&b[i]);

    printf("Enter process sizes:\n");
    for(i=0;i<np;i++)
        scanf("%d",&p[i]);

    for(i=0;i<np;i++)
    {
        allocation[i]=-1;

        for(j=0;j<nb;j++)
        {
            if(b[j]>=p[i])
            {
                allocation[i]=j;
                b[j]-=p[i];
                break;
            }
        }
    }

    printf("\nProcess\tBlock\n");
    for(i=0;i<np;i++)
        printf("%d\t%d\n",i+1,allocation[i]+1);

    return 0;
}
