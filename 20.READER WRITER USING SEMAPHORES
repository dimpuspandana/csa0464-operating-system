#include<stdio.h>
#include<pthread.h>
#include<semaphore.h>

sem_t wrt;
int data=0;

void *reader()
{
    printf("Reader Reads Data = %d\n",data);
    return NULL;
}

void *writer()
{
    sem_wait(&wrt);

    data=100;
    printf("Writer Writes Data = %d\n",data);

    sem_post(&wrt);
    return NULL;
}

int main()
{
    pthread_t r,w;

    sem_init(&wrt,0,1);

    pthread_create(&r,NULL,reader,NULL);
    pthread_create(&w,NULL,writer,NULL);

    pthread_join(r,NULL);
    pthread_join(w,NULL);

    sem_destroy(&wrt);

    return 0;
}
