#include <stdio.h>

int main() {
    int pages[20], frames[10];
    int n, f, i, j, k = 0, faults = 0, flag;

    printf("Enter number of pages: ");
    scanf("%d", &n);

    printf("Enter page reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter frame size: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
        frames[i] = -1;

    for(i = 0; i < n; i++) {
        flag = 0;

        for(j = 0; j < f; j++)
            if(frames[j] == pages[i])
                flag = 1;

        if(flag == 0) {
            frames[k] = pages[i];
            k = (k + 1) % f;
            faults++;
        }
    }

    printf("Page Faults = %d\n", faults);

    return 0;
}
